<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- After commit, so a rolled-back save is never synced and the API sees final data. -->
    <event name="catalog_product_save_commit_after">
        <observer name="visualsearch_sync_product_on_save" instance="VisualSearch\Connector\Observer\ProductSaveObserver"/>
    </event>
</config>
